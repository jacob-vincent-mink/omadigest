{
  "version": 1,
  "id": "focus-reentry",
  "name": "Focus Re-entry",
  "description": "A calm catch-up briefing after a focus session.",
  "priority": 80,
  "match": {
    "triggers": ["dnd-ended"],
    "minimumItems": 3,
    "minimumFocusMinutes": 5
  },
  "context": {
    "connectors": [
      "notifications",
      "io.github.jacob-vincent-mink.github",
      "io.omarchy.crash-reports",
      "io.omarchy.updates",
      "io.omarchy.system-telemetry",
      "io.omarchy.herdr"
    ],
    "maximumItems": 50,
    "maximumBytes": 60000
  },
  "output": {
    "sections": ["Needs you", "Changed while away", "No action"],
    "maximumEntries": 12
  }
}
