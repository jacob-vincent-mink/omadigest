{
  "version": 1,
  "id": "general",
  "name": "General Digest",
  "description": "A balanced briefing for any set of attention items.",
  "priority": 10,
  "match": {},
  "context": {
    "connectors": [
      "notifications",
      "io.github.jacob-vincent-mink.github",
      "io.github.jacob-vincent-mink.google-calendar",
      "io.github.jacob-vincent-mink.linear",
      "io.github.jacob-vincent-mink.slack",
      "io.github.jacob-vincent-mink.todoist",
      "io.github.jacob-vincent-mink.x",
      "io.github.jacob-vincent-mink.rss",
      "io.omarchy.crash-reports",
      "io.omarchy.updates",
      "io.omarchy.system-telemetry"
    ],
    "maximumItems": 40,
    "maximumBytes": 50000
  },
  "output": {
    "sections": ["Act now", "Review soon", "No action"],
    "maximumEntries": 12
  }
}
